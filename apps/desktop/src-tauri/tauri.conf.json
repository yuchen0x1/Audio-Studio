{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Studio",
  "version": "0.2.0",
  "identifier": "com.audiostudio.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5180"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Studio",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QTdEQkJDMEY1QUREMjcKUldRbjNWb1B2TnVuRjVjTU8rWTlGcEFJQnhFakFWb0kyWHkzTWY0MVpzU3pma0JJTFc2eURVUzkK",
      "endpoints": [
        "https://github.com/yuchen0x1/Audio-Studio/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
