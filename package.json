{
  "name": "audio-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Audio Studio - 多平台专业音频转换软件 (Web / Windows / Android)",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @audio-studio/web dev",
    "build:web": "pnpm --filter @audio-studio/web build",
    "build:desktop-ui": "pnpm --filter @audio-studio/web build -- --mode desktop",
    "test": "pnpm --filter @audio-studio/shared test && pnpm --filter @audio-studio/web test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
