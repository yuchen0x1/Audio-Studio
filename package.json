{
  "name": "audio-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Audio Studio - 多平台专业音频转换软件 (Web / Windows / Android)",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @audio-studio/web dev",
    "build:web": "pnpm --filter @audio-studio/web build",
    "build:desktop-ui": "pnpm --filter @audio-studio/web build -- --mode desktop",
    "build:desktop": "pnpm build:desktop-ui && pnpm --filter @audio-studio/desktop build",
    "test": "pnpm --filter @audio-studio/shared test && pnpm --filter @audio-studio/web test",
    "test:desktop": "pnpm --filter @audio-studio/desktop test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/shared/src/**/*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/shared/src/**/*.ts\" \"*.mjs\"",
    "test:coverage": "pnpm --filter @audio-studio/shared test:coverage && pnpm --filter @audio-studio/web test:coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
